<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AppCepeRio.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppCepeRio"
    xmlns:views="clr-namespace:AppCepeRio.Views"
    Title="AppCepeRio">

    <ShellContent
        Title="OnBoarding"
        ContentTemplate="{DataTemplate views:OnBoarding}"
        Route="OnBoarding" />

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginView}"
        Route="LoginView" />

</Shell>
